# BirrVoice Ledger — Environment Configuration Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.

# Voxide API key — get from https://voxide.dev/dashboard
# NOTE: For production, route this through a server-side proxy (api/voxide-proxy.js)
# so the key is NOT embedded in the client bundle.
VITE_VOXIDE_API_KEY=your_voxide_api_key_here
